{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gumcord",
  "version": "0.2.1",
  "identifier": "com.gumilho.gumcord",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "https://gumcord.proxy.gumilho.com"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Gumcord",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "backgroundColor": "#1a1b2e",
        "theme": "Dark",
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
