# Copy to .env next to docker-compose.yml (production) or backend/.env (development).

# Where people open Gumcord. The OIDC callback is PUBLIC_URL/api/auth/callback.
PUBLIC_URL=https://gumcord.example.com

# PocketID OIDC client: PocketID → OIDC Clients → Add.
OIDC_ISSUER=https://auth.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Members of this PocketID group are Gumcord admins: they create servers and add people to them.
ADMIN_GROUP=gumcord-admins

# Must match the keys: entry in livekit.yaml.
LK_API_KEY=gumcord
LK_API_SECRET=

# Optional:
# ADDR=:8080
# LIVEKIT_API_URL=http://127.0.0.1:7880   # LiveKit's HTTP API, for who's-in-voice; docker-compose.yml sets it
# DATA_DIR=data        # database, uploads and session key
# STATIC_DIR=          # built app to serve; the Docker image sets this
# SESSION_SECRET=      # generated into DATA_DIR/session.key when unset
# DEV_LOGIN=1          # development only, instead of OIDC: sign in with any name
