# Builds the desktop app from this checkout, so it needs no release or AUR upload:
#   cd packaging/arch && makepkg -si
# Only committed changes are built (makepkg clones the repo); the version comes from the latest tag.

pkgname=gumcord
pkgver=0.3.0.r16.gc4b92ee
pkgrel=1
pkgdesc='Desktop app for Gumcord, a self-hosted chat, voice and screen sharing server'
arch=(x86_64)
url='https://github.com/Gumilho/gumcord'
license=(MIT)
# The gst-* packages are what WebKitGTK uses for WebRTC and the microphone (voice calls don't connect
# without them), and for the MP3 sound effects (gst-libav).
depends=(cairo gdk-pixbuf2 glib2 gst-libav gst-plugin-pipewire gst-plugins-bad gst-plugins-good gtk3
         libayatana-appindicator libsoup3 webkit2gtk-4.1)
makedepends=(cargo git)
options=(!debug)
source=("$pkgname::git+file://$(realpath "$startdir/../..")"
        "$pkgname.desktop")
sha256sums=('SKIP'
            'SKIP')

pkgver() {
  cd "$pkgname"
  # v0.3.0-5-gabc1234 -> 0.3.0.r5.gabc1234
  git describe --tags --long | sed 's/^v//; s/\([^-]*-g\)/r\1/; s/-/./g'
}

prepare() {
  cd "$pkgname/src-tauri"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname/src-tauri"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # The app loads the hosted site, so there's no frontend to bundle. `custom-protocol` is what
  # `tauri build` turns on for release builds; without it the binary loads the dev URL instead.
  cargo build --release --frozen --features tauri/custom-protocol
}

package() {
  cd "$pkgname"
  install -Dm755 src-tauri/target/release/gumcord -t "$pkgdir/usr/bin"
  install -Dm644 "$srcdir/$pkgname.desktop" -t "$pkgdir/usr/share/applications"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"

  local icons=src-tauri/icons
  install -Dm644 $icons/32x32.png        "$pkgdir/usr/share/icons/hicolor/32x32/apps/$pkgname.png"
  install -Dm644 $icons/128x128.png      "$pkgdir/usr/share/icons/hicolor/128x128/apps/$pkgname.png"
  install -Dm644 $icons/128x128@2x.png   "$pkgdir/usr/share/icons/hicolor/256x256/apps/$pkgname.png"
  install -Dm644 $icons/icon.png         "$pkgdir/usr/share/icons/hicolor/512x512/apps/$pkgname.png"
}
